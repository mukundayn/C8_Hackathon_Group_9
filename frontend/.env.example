# Clerk (browser publishable key — consumed at build time by vite.config.ts `define`)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Optional: point the frontend at a non-same-origin backend.
# Leave empty for production (FastAPI serves the SPA + /api on one origin)
# and for local dev (the Vite proxy forwards /api → http://localhost:8000).
VITE_API_BASE_URL=
