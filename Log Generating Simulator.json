    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nif (!item || typeof item !== 'object') {\n  throw new Error('Input item is missing or invalid');\n}\n\nif (!item.content) {\n  throw new Error('No content field found from previous GitHub node. Make sure you are using Get File, not List Files.');\n}\n\nconst content = Buffer.from(item.content, 'base64').toString('utf-8');\nconst lines = content.split('\\n').filter(line => line.trim());\n\nlet highestCategory = 'Low';\nlet highestSeverity = 'INFO';\n\nfor (const line of lines) {\n  if (line.includes('CRITICAL')) {\n    highestCategory = 'Critical';\n    highestSeverity = 'CRITICAL';\n    break;\n  } else if (line.includes('ERROR') && highestCategory !== 'Critical') {\n    highestCategory = 'High';\n    highestSeverity = 'ERROR';\n  } else if ((line.includes('WARNING') || line.includes('WARN')) && highestCategory === 'Low') {\n    highestCategory = 'Medium';\n    highestSeverity = 'WARNING';\n  }\n}\n\nreturn [{\n  json: {\n    fileName: item.name || 'unknown',\n    fullContent: content,\n    lineCount: lines.length,\n    category: highestCategory,\n    severity: highestSeverity,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
